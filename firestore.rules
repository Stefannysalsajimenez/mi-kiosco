rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasPhone() {
      return request.auth != null && request.auth.token.phone_number != null;
    }

    function isAdmin() {
      return hasPhone()
        && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.phones is list
        && request.auth.token.phone_number in get(/databases/$(database)/documents/config/admin).data.phones;
    }

    function isStaff() {
      return hasPhone()
        && exists(/databases/$(database)/documents/config/staff)
        && get(/databases/$(database)/documents/config/staff).data.phones is list
        && request.auth.token.phone_number in get(/databases/$(database)/documents/config/staff).data.phones;
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    function isStockOnlyDecrease() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt', 'active'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active'])
          || (request.resource.data.stock == 0 && request.resource.data.active == false)
        );
    }

    function isValidOrder() {
      return request.resource.data.customer is string
        && request.resource.data.customer.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'pending';
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdminOrStaff();
      allow update: if isAdminOrStaff() || isStockOnlyDecrease();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /orders/{orderId} {
      allow create: if isValidOrder();
      allow read: if true;
      allow update, delete: if isAdminOrStaff();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdminOrStaff();
    }

    match /blocked_clients/{clientId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /session_log/{sessionId} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }

    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /audit_log/{auditId} {
      allow create, read: if isAdminOrStaff();
      allow update, delete: if false;
    }

    match /paymentProofs/{orderId} {
      function linkedOrder() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      allow create: if (isAdminOrStaff() || (
          request.auth == null
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && linkedOrder().paymentProofExpected == true
          && linkedOrder().paymentMethod == request.resource.data.paymentMethod
        ))
        && request.resource.data.keys().hasOnly([
          'orderId', 'paymentMethod', 'imageData', 'fileName',
          'contentType', 'originalType', 'encodedLength', 'createdAt'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.paymentMethod in ['card', 'yape', 'plin']
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 100
        && request.resource.data.imageData.size() <= 420000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 120
        && request.resource.data.contentType is string
        && request.resource.data.contentType.matches('image/.*')
        && request.resource.data.encodedLength is int
        && request.resource.data.encodedLength > 100
        && request.resource.data.encodedLength <= 420000;

      allow read, update, delete: if isAdminOrStaff();
    }
  }
}
