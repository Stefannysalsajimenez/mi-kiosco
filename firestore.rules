rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{d}    { allow read: if true; allow write: if request.auth != null; }
    match /products/{id} { allow read: if true; allow write: if request.auth != null; }
    match /categories/{id}{ allow read: if true; allow write: if request.auth != null; }
    match /orders/{id}   { allow create: if true; allow read: if true; allow update,delete: if request.auth != null; }
    match /chats/{id}           { allow read,write: if true; }
    match /chats/{id}/messages/{m}{ allow read,write: if true; }
    match /audit_log/{id}       { allow read,write: if request.auth != null; }
  }
}
