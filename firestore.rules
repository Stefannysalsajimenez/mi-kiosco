rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStockOnlyDecrease() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    function isValidOrder() {
      return request.resource.data.customer is string
        && request.resource.data.customer.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'pending';
    }

    match /config/{documentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() || isStockOnlyDecrease();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow create: if isValidOrder();
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /audit_log/{documentId} {
      allow read, write: if isAuthenticated();
    }
  }
}
