rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.phone_number != null
        && request.auth.token.phone_number in firestore.get(
          /databases/(default)/documents/config/admin
        ).data.phones;
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage(8 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage(8 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
