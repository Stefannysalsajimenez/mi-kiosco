# Firebase Admin: use ONE of the following two methods.
# Recommended: the complete service-account JSON encoded in Base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Alternative: individual values.
FIREBASE_PROJECT_ID=mi-kiosco-c7313
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated Firebase Auth UIDs allowed to call admin-only endpoints.
# Obtain each UID from Firebase Console > Authentication > Users.
ADMIN_UIDS=

# Comma-separated web origins authorized to call the public endpoints.
ALLOWED_ORIGINS=https://mi-kiosco-c7313.web.app,https://mi-kiosco-c7313.firebaseapp.com

# Optional canonical public URL used in push notifications and QR codes.
PUBLIC_STORE_URL=https://mi-kiosco-c7313.web.app

# CallMeBot opt-in mapping. Each customer must activate CallMeBot first.
# JSON format: {"51999999999":"API_KEY_DEL_CLIENTE"}
CALLMEBOT_CLIENT_KEYS_JSON={}

# Optional sender label shown in WhatsApp summaries.
WHATSAPP_STORE_NAME=Kiosco
